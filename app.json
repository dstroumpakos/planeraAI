{
  "expo": {
    "name": "Planera AI Travel Planner",
    "slug": "planera-ai-travel-planner",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/images/appicon-1024x1024-01-9h6cls.jpg",
    "scheme": "planeraai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#171717"
    },
    "ios": {
      "supportsTablet": false,
      "newArchEnabled": true,
      "bundleIdentifier": "com.dstroump.planeraaitravelplanner",
      "appleTeamId": "97G74KAACL",
      "associatedDomains": [
        "applinks:planeraai.app",
        "applinks:www.planeraai.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Planera needs access to your photo library so you can select a profile photo.",
        "NSLocationWhenInUseUsageDescription": "Planera uses your location to verify you've visited destinations and unlock travel achievements, show your position on the trip map, help you navigate to activities, and notify you when you are near a planned stop on your itinerary."
      },
      "splash": {
        "image": "./assets/images/splash-blank.png",
        "resizeMode": "contain",
        "backgroundColor": "#171717"
      }
    },
    "android": {
      "package": "com.dstroump.planeraaitravelplanner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/appicon-1024x1024-01-9h6cls.jpg",
        "backgroundColor": "#FAF9F6"
      },
      "newArchEnabled": true,
      "splash": {
        "image": "./assets/images/splash-blank.png",
        "resizeMode": "contain",
        "backgroundColor": "#171717"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "planeraai.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.planeraai.app",
              "pathPrefix": "/invite"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#171717"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-iap",
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Planera uses your location to verify you've visited destinations and unlock travel achievements, show your position on the trip map, help you navigate to activities, and notify you when you are near a planned stop on your itinerary."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/appicon-1024x1024-01-9h6cls.jpg",
          "color": "#1B3F92",
          "sounds": []
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Planera adds your trips to your calendar so your travel dates and day-by-day plan are always at hand.",
          "remindersPermission": "Planera can add reminders for your planned trip activities."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.dstroump.planeraaitravelplanner.widgets",
          "groupIdentifier": "group.com.dstroump.planeraaitravelplanner",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "TripCountdownWidget",
              "displayName": "Trip countdown",
              "description": "Days until your next trip, and today's next stop while you're away.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ac0a8a4-c019-48ac-b8a3-4651a864b089"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2ac0a8a4-c019-48ac-b8a3-4651a864b089"
    }
  }
}
